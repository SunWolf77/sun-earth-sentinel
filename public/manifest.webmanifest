{
  "id": "/",
  "name": "Sun-Earth Sentinel",
  "short_name": "Sentinel",
  "description": "Sun-Earth observatory — seismic + space weather + SUPT continuum. Free public feeds (USGS, NOAA SWPC, NASA). Null is valid.",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "browser"],
  "orientation": "any",
  "background_color": "#0b0b0f",
  "theme_color": "#14b8a6",
  "lang": "en",
  "dir": "ltr",
  "categories": ["education", "news", "utilities", "weather"],
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "maskable"
    },
    {
      "src": "/og.png",
      "sizes": "1200x630",
      "type": "image/png",
      "purpose": "any"
    }
  ],
  "screenshots": [
    {
      "src": "/og.png",
      "sizes": "1200x630",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Sun-Earth Sentinel overview"
    }
  ],
  "shortcuts": [
    {
      "name": "Live Map",
      "short_name": "Map",
      "description": "Seismic live map + nodes",
      "url": "/?tab=live&source=pwa-shortcut",
      "icons": [{ "src": "/favicon.svg", "sizes": "any", "type": "image/svg+xml" }]
    },
    {
      "name": "Solar Observatory",
      "short_name": "Solar",
      "description": "Space weather command center",
      "url": "/?tab=solar&source=pwa-shortcut",
      "icons": [{ "src": "/favicon.svg", "sizes": "any", "type": "image/svg+xml" }]
    },
    {
      "name": "Catalog Rhythm",
      "short_name": "Rhythm",
      "description": "SUPT seismic timing read",
      "url": "/?tab=resonance&source=pwa-shortcut",
      "icons": [{ "src": "/favicon.svg", "sizes": "any", "type": "image/svg+xml" }]
    },
    {
      "name": "Charts",
      "short_name": "Charts",
      "description": "Supporting time series",
      "url": "/?tab=analytics&source=pwa-shortcut",
      "icons": [{ "src": "/favicon.svg", "sizes": "any", "type": "image/svg+xml" }]
    }
  ],
  "related_applications": [],
  "handle_links": "preferred",
  "launch_handler": {
    "client_mode": "navigate-existing"
  }
}
